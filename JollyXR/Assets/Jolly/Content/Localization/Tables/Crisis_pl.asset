  m_TableData:
  - m_Id: 552591360
    m_Localized: "zabi\u0107 si\u0119|zabij\u0119 si\u0119|samob\xF3jstwo|samob\xF3jcze|nie chc\u0119 \u017Cy\u0107|chc\u0119 umrze\u0107|skrzywdzi\u0107 si\u0119|odebra\u0107 sobie \u017Cycie"
    m_Metadata:
      m_Items: []
  - m_Id: 560979968
    m_Localized: "stop|st\xF3j|czekaj|zaczekaj|zosta\u0144|przesta\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 565174272
    m_Localized: "{name}|prosz\u0119|teraz|tam|tu|no|hej|ok|okej"
    m_Metadata:
      m_Items: []
  - m_Id: 569368576
    m_Localized: "chod\u017A tu|chod\u017A tutaj|chod\u017A do mnie|chod\u017A bli\u017Cej|podejd\u017A|podejd\u017A tu|podejd\u017A bli\u017Cej|podejd\u017A do mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 577757184
    m_Localized: "{name}|prosz\u0119|cze\u015B\u0107|hej|witaj"
    m_Metadata:
      m_Items: []
  - m_Id: 581951488
    m_Localized: "otw\xF3rz ustawienia|poka\u017C ustawienia|ustawienia|otw\xF3rz menu|poka\u017C menu"
    m_Metadata:
      m_Items: []
  - m_Id: 586145792
    m_Localized: "zamknij ustawienia|ukryj ustawienia|zamknij menu|ukryj menu"
    m_Metadata:
      m_Items: []
  - m_Id: 590340096
    m_Localized: "{name}|prosz\u0119|hej|teraz|ok|okej|mo\u017Cesz"
    m_Metadata:
      m_Items: []
  - m_Id: 594534400
    m_Localized: "{name}|prosz\u0119|cze\u015B\u0107|hej|ok|okej|teraz|jeszcze raz|dla mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 598728704
    m_Localized: nie|nigdy|bez|stop
    m_Metadata:
      m_Items: []
  - m_Id: 602923008
    m_Localized: "skocz|podskocz|skacz|zr\u00F3b skok"
    m_Metadata:
      m_Items: []
  - m_Id: 607117312
    m_Localized: "zata\u0144cz|ta\u0144cz|poka\u017C jak ta\u0144czysz|poka\u017C jak si\u0119 ta\u0144czy|poka\u017C taniec|zata\u0144czmy"
    m_Metadata:
      m_Items: []
  - m_Id: 611311616
    m_Localized: "obr\u00F3\u0107 si\u0119|zakr\u0119\u0107 si\u0119|zr\u00F3b obr\u00F3t|zr\u00F3b piruet"
    m_Metadata:
      m_Items: []
  - m_Id: 615505920
    m_Localized: "uk\u0142o\u0144 si\u0119|pok\u0142o\u0144 si\u0119|zr\u00F3b uk\u0142on"
    m_Metadata:
      m_Items: []
  - m_Id: 619700224
    m_Localized: pomachaj|pomachaj mi|pomachaj do mnie|zamachaj
    m_Metadata:
      m_Items: []
  - m_Id: 623894528
    m_Localized: "kiwnij g\u0142ow\u0105|ski\u0144 g\u0142ow\u0105|pokiwaj g\u0142ow\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 628088832
    m_Localized: "\u015Bwi\u0119tuj|\u015Bwi\u0119tujmy|po\u015Bwi\u0119tuj"
    m_Metadata:
      m_Items: []
  - m_Id: 632283136
    m_Localized: "sta\u0144 za mn\u0105|id\u017A za mnie|przejd\u017A za mnie|sta\u0144 za mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 636477440
    m_Localized: "sta\u0144 przede mn\u0105|id\u017A przede mnie|przejd\u017A przede mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 640671744
    m_Localized: "sta\u0144 po mojej lewej|sta\u0144 po lewej|id\u017A na moj\u0105 lew\u0105|sta\u0144 z lewej|przejd\u017A na lewo ode mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 644866048
    m_Localized: "sta\u0144 po mojej prawej|sta\u0144 po prawej|id\u017A na moj\u0105 praw\u0105|sta\u0144 z prawej|przejd\u017A na prawo ode mnie"
    m_Metadata:
      m_Items: []
  - m_Id: 649060352
    m_Localized: "bli\u017Cej|chod\u017A bli\u017Cej|podejd\u017A bli\u017Cej|przysu\u0144 si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 653254656
    m_Localized: "odsu\u0144 si\u0119|cofnij si\u0119|odejd\u017A troch\u0119|zr\u00F3b krok w ty\u0142"
    m_Metadata:
      m_Items: []
